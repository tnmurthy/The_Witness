# =============================================================================
# .env.staging — Staging environment template
#
# DO NOT commit real values. Copy this to .env.staging.local and fill in
# the staging project values. The staging Supabase project should be a
# separate project from production — never point staging at the production DB.
#
# Provisioning a staging project:
#   1. Supabase Dashboard → New Project (name: "the-witness-staging")
#   2. Apply migrations: paste supabase/combined/001_complete_schema_all_migrations.sql
#   3. Copy the project URL, anon key, and service role key here
#   4. Run: NEXT_PUBLIC_SUPABASE_URL=<staging-url> node scripts/bootstrap.js
# =============================================================================

# Supabase — staging project (DIFFERENT from production)
NEXT_PUBLIC_SUPABASE_URL=https://STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=STAGING_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.STAGING_REF.supabase.co:5432/postgres

# Application
NEXT_PUBLIC_SITE_URL=https://staging.thewitness.app
REQUIRE_SERVICE_ROLE=true

# Email — can use the same Resend account with a staging sender address
RESEND_API_KEY=re_staging_key
EMAIL_FROM=staging@yourdomain.com
EMAIL_FROM_NAME=The Witness (Staging)

# Monitoring — use a separate Sentry environment
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=the-witness-staging
SENTRY_ENVIRONMENT=staging

# Rate limiting — can share the Upstash instance with a different prefix
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# AI providers
OPENAI_API_KEY=sk-proj-staging-key
ANTHROPIC_API_KEY=sk-ant-staging-key

# Cron
CRON_SECRET=staging-cron-secret-change-me
