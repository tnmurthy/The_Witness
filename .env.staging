# The Witness — Staging Environment Configuration
# This file is committed to version control as a TEMPLATE only.
# Actual values are injected via Vercel Environment Variables (staging branch).
# Never put real secrets in this file.

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://the-witness-staging.vercel.app

# Set these as Vercel Environment Variables for the staging environment:
# NEXT_PUBLIC_SUPABASE_URL     → your staging Supabase project URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY → staging anon key
# SUPABASE_SERVICE_ROLE_KEY    → staging service role key
# ANTHROPIC_API_KEY or OPENAI_API_KEY → AI provider key for testing
