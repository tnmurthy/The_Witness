{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/process-embeddings",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-scheduled",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "REQUIRE_SERVICE_ROLE": "true"
  }
}
