# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real credentials.
#
# Every variable here is validated at startup by src/lib/env.ts. Missing
# or malformed values fail fast with a clear error instead of surfacing as
# a confusing runtime error inside a Supabase client call.

# --- Supabase (see README "Provisioning Supabase" for how to get these) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_. Only needed for server-side admin tasks;
# not required for Milestone 1 to run.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OAuth providers (Milestone 2 — see docs/AUTHENTICATION.md for setup) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# --- AI providers (reserved for Milestone 5 — AI Workspace; not required yet) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
