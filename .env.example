# The Witness — Environment Variables
# Copy this file to .env.local for local development.
# .env.local is git-ignored — never commit real credentials.
#
# All variables are validated at startup by src/lib/env.ts.
# Missing or malformed values fail fast with a clear error message.
#
# For production (Vercel), set these as Environment Variables in:
#   Vercel Dashboard → Project → Settings → Environment Variables

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key (safe to expose to the browser — RLS protects all data)
# From: Project Settings → API → Project API keys → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — KEEP SECRET, never prefix with NEXT_PUBLIC_
# Bypasses Row Level Security. Required in staging/production.
# From: Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Postgres URL — for migration scripts and bootstrap only.
# Use the POOLER URL (port 6543) in production for the running app.
# From: Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ─── Site ──────────────────────────────────────────────────────────────────────
# Your app's canonical URL — used for auth redirects.
# Local: http://localhost:3000
# Production: https://your-app.vercel.app or your custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── OAuth Providers (optional but recommended) ────────────────────────────────
# Google — from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI to add in Google Console:
#   https://your-project-ref.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# GitHub — from GitHub Settings → Developer settings → OAuth Apps
# Callback URL to add in GitHub:
#   https://your-project-ref.supabase.co/auth/v1/callback
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# ─── AI Providers ──────────────────────────────────────────────────────────────
# At least one is required for the AI Workspace to function.
# Anthropic is preferred when both are set (see src/lib/ai/registry.ts).
# Neither is required for the rest of the app to build and run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Service role enforcement ───────────────────────────────────────────────────
# Set to "true" in Vercel staging/production environment variables to enforce
# that SUPABASE_SERVICE_ROLE_KEY is present at startup. Without this flag,
# missing the service role key causes a silent runtime failure only when an
# admin-privileged route is called. With this flag, the app fails fast at
# startup with a clear error message instead.
#
# Add REQUIRE_SERVICE_ROLE=true to your Vercel Environment Variables for
# staging and production. Leave unset (or set to false) for local development.
REQUIRE_SERVICE_ROLE=false
